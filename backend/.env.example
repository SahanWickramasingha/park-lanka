# Copy to backend/.env and enter both passwords locally. No default accounts/passwords.
DATABASE_URL=jdbc:postgresql://localhost:5432/parking_pos
DATABASE_USER=parking_app
DATABASE_PASSWORD=admin
PARKING_ADMIN_USER=admin
PARKING_ADMIN_PASSWORD=Sahan@2003
# Cloud: use the provider hostname, sslmode=verify-full and its trusted root certificate.
# DATABASE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=verify-full&sslrootcert=C:/certs/provider-root.crt
# PARKING_PG_DUMP=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# Server-issued checkout quote lifetime in seconds (default 120; allowed 1..86400).
PARKING_CHECKOUT_QUOTE_VALIDITY_SECONDS=120
